{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review/symbol_ledger.json: every symbol's meaning per section, from the presentation-reviewer",
  "type": "object",
  "required": ["schema_version", "reviewer", "symbols"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewer": {"$ref": "defs.json#/$defs/text"},
    "symbols": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/symbol"},
                "description": "every symbol and named object of the explainer"}
  },
  "$defs": {
    "symbol": {
      "type": "object",
      "required": ["symbol", "uses"],
      "if": {"required": ["uses"], "properties": {"uses": {"type": "array", "contains": {
        "type": "object", "required": ["change"], "properties": {"change": {"const": "unannounced"}}}}}},
      "then": {"required": ["finding"], "properties": {"finding": {"type": "string", "pattern": "^(PRES|LR)-\\d+$",
        "description": "an unannounced change of meaning must name its finding: PRES-n or LR-n"}}},
      "properties": {
        "symbol": {"$ref": "defs.json#/$defs/text"},
        "uses": {
          "type": "array",
          "minItems": 1,
          "description": "in document order",
          "prefixItems": [{"$ref": "#/$defs/use", "properties": {
            "change": {"const": "first", "description": "the first use defines the symbol"}}}],
          "items": {"$ref": "#/$defs/use", "properties": {"change": {"enum": ["none", "announced", "unannounced"]}}}
        },
        "finding": {"type": ["string", "null"], "pattern": "^[A-Z]{2,4}-\\d+$", "description": "a finding id such as PRES-3"}
      }
    },
    "use": {
      "type": "object",
      "required": ["section", "location", "meaning", "change"],
      "properties": {
        "section": {"$ref": "defs.json#/$defs/text"},
        "location": {"$ref": "defs.json#/$defs/text"},
        "meaning": {"$ref": "defs.json#/$defs/text"},
        "defined_from": {"type": ["string", "null"], "pattern": "\\S"}
      }
    }
  }
}
