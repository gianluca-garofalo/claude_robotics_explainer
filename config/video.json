  "sources": {
    "action_safe_inset, graphics_safe_inset": "EBU R 95 safe areas for 16:9: action-safe 93 %, graphics-safe 90 % of the picture.",
    "min_cap_px_*": "A 22 px cap height at 1080p is about 0.2 degrees of x-height on a phone, the low end of fluent reading (Legge and Bigelow 2011).",
    "contrast_*": "WCAG 2.x contrast ratio: 4.5:1 for normal text, 3:1 for large text (success criterion 1.4.3).",
    "cvd_*": "Machado et al. (2009) colour-vision deficiency simulation, CIEDE2000 difference: below 5 two colours read as one, below 12 they need a label or a shape too.",
    "max_elements_*, max_text_items_*": "Tunable defaults against clutter (one idea per scene).",
    "thumbnail_small": "168 x 94 px, the small thumbnail size in YouTube's suggested-video lists.",
    "text_wpm": "Below the 238 words per minute adult silent reading rate for non-fiction (Brysbaert 2019), because viewers read while they listen.",
    "equation_*": "House rule: hold a new equation 2 to 3 s before speaking over it; the per-term time is tunable.",
    "narration_factor, narration_overlap": "Tunable default: reading while the narration says something else takes longer.",
    "min_display_s": "A floor for any label, like the minimum subtitle duration of timed-text style guides.",
    "narration_wpm_*": "House pacing rule of 130 to 150 spoken words per minute; the thresholds are tunable.",
    "equation_numbers": "false rejects every equation label in the video; true allows only its own (1), (2), ... in order of appearance.",
    "self_contained": "Nothing in the video refers to the explainer, code, files, links or a document's numbering; 'allow' lists patterns removed before matching.",
    "recall": "A callback to an equation no longer on screen loads working memory (Cowan 2001): a design warning, never an error.",
    "min_gap_*": "0.15 units (about 20 px at 1080p) keeps two labels, or a label and a strong stroke, visibly apart on a phone; under 0.05 they read as one.",
    "thumbnail_*": "thumbnail_title_shade is the opacity of the panel under the thumbnail title; the busy thresholds bound edge density and luminance spread behind it.",
    "numbers": "Numbers as a person writes them (2-3 significant digits, no trailing zeros, exact values exactly), formatted by fmt() and checked by tools/video/check_numbers.py.",
    "space_*": "Composition warnings of check_design.py (coverage, balance, empty regions, extent), not a standard.",
    "motion_*": "Checks during animations: opaque texts overlapping while something moves, and a live readout whose width jitters.",
    "series": "Opening, recap, outro and packaging targets of tools/video/check_series.py (warnings).",
    "align_*": "Alignment warnings of check_design.py for stacked or side-by-side texts that almost line up.",
    "panel_*": "Panel-balance warnings of check_design.py for side-by-side panels that end at very different heights or leave a large empty block (not in the outro).",
    "engagement": "Starting values of tools/video/check_engagement.py (motion, cuts, transforms, narration, the metaphor): warnings until calibrated (errors_block_gate false).",
    "quantities": "One colour per quantity, not per role, from the colour-blind-safe semantic palette.",
    "title_beat": "title_beat_max_s and title_beat_min_speech: one spoken sentence over the title, then the body (check_series.py warnings).",
    "thumbnail_min_ink": "The share of a picture-layout thumbnail's picture that carries ink at 168 x 94 (warning).",
    "script": "The spoken-script standard of tools/video/check_script.py (pause marks, contractions, connectives, rhythm, stock phrases, pace): report only until calibrated.",
    "pacing": "Rules P1-P20 of tools/video/check_pacing.py and the idea budget (plan) of tools/video/idea_budget.py: warnings, except three errors, which block the gate."
  },
